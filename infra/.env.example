# Copy this file to infra/.env (gitignored) and fill in the values.

# Free LocalStack auth token: sign in at https://app.localstack.cloud and open "Auth Tokens".
LOCALSTACK_AUTH_TOKEN=

# Optional: set to 1 for verbose LocalStack logs, or to keep state across restarts.
# LOCALSTACK_DEBUG=0
# LOCALSTACK_PERSISTENCE=0

# --- Real AWS (just aws-*) ---
# AWS CLI profile to deploy with, e.g. an IAM Identity Center profile (run `aws sso login` first).
# AWS_PROFILE=
# AWS_REGION=eu-north-1

# 12-digit account ID; deploys are refused in any other account.
# RAG_AWS_ACCOUNT_ID=

# Who sends the sign-in codes: a domain you own (e.g. uurag.se) or one email address.
# An email address is the quickest start: SES emails it a link to click once.
# RAG_SES_IDENTITY=

# Optional: Route 53 hosted zone of that domain, so DKIM/DMARC records are created for you.
# RAG_ROUTE53_ZONE_ID=

# Optional: comma-separated domains allowed to register (default uu.se,student.uu.se).
# RAG_ALLOWED_EMAIL_DOMAINS=uu.se,student.uu.se

# Optional: Bedrock model or inference profile the chat answers with (default us.amazon.nova-micro-v1:0).
# RAG_BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
