# Copy this file to infra/.env (gitignored) and fill in the values.

# Free LocalStack auth token: sign in at https://app.localstack.cloud and open "Auth Tokens".
LOCALSTACK_AUTH_TOKEN=

# Optional: set to 1 for verbose LocalStack logs, or to keep state across restarts.
# LOCALSTACK_DEBUG=0
# LOCALSTACK_PERSISTENCE=0

# Optional: the model that answers locally. By default LocalStack's Bedrock runs LOCALSTACK_BEDROCK_MODEL
# with Ollama, on the GPU once `just gpu-setup` made nvidia Docker's default runtime (`just up` then
# sets LOCALSTACK_BEDROCK_DOCKER_FLAGS to ask for it), otherwise on CPU (minutes per answer). "stub" answers
# with CI's deterministic stand-in instead, in seconds; then also set LOCALSTACK_BEDROCK_PREWARM=0 so
# no model is pulled at startup. Run `just restart` and `just apply` after changing.
# RAG_LOCAL_MODEL_API=converse
# LOCALSTACK_BEDROCK_MODEL=llama3.2:3b
# LOCALSTACK_BEDROCK_PREWARM=1
# LOCALSTACK_BEDROCK_DOCKER_FLAGS=

# --- Real AWS (just aws-*) ---
# AWS CLI profile to deploy with, e.g. an IAM Identity Center profile (run `aws sso login` first).
# AWS_PROFILE=
# AWS_REGION=eu-north-1

# 12-digit account ID; deploys are refused in any other account.
# RAG_AWS_ACCOUNT_ID=

# Who sends the sign-in codes: a domain you own (e.g. uurag.se) or one email address.
# An email address is the quickest start: SES emails it a link to click once.
# RAG_SES_IDENTITY=

# Optional: Route 53 hosted zone of that domain, so DKIM/DMARC records are created for you.
# RAG_ROUTE53_ZONE_ID=

# Optional: comma-separated domains allowed to register (default uu.se,student.uu.se).
# RAG_ALLOWED_EMAIL_DOMAINS=uu.se,student.uu.se

# Optional: how the recommender calls Bedrock and which model answers. The default "openai" calls Chat
# Completions on bedrock-mantle (quotas separate from bedrock-runtime's) with Qwen3 32B; "converse"
# calls Converse on bedrock-runtime with a model or inference profile, e.g. us.amazon.nova-micro-v1:0.
# RAG_BEDROCK_MODEL_API=openai
# RAG_BEDROCK_MODEL_ID=qwen.qwen3-32b

# Optional: monthly cost budget in USD (default 10) and comma-separated emails for its alerts
# (default RAG_SES_IDENTITY when that is an email address).
# RAG_BUDGET_LIMIT_USD=10
# RAG_BUDGET_EMAILS=me@example.com

# Optional: trace the chat Lambda in Arize AX. The space ID is in the app.arize.com URL, after
# /spaces/. Store the API key once with `just aws-arize-key` (kept in SSM, never in this file), then
# `just aws-apply`. Tracing stays off while RAG_ARIZE_SPACE_ID is empty.
# RAG_ARIZE_SPACE_ID=
# RAG_TRACING_PROJECT=rag-aws
# EU spaces: https://otlp.eu-west-1a.arize.com/v1/traces
# RAG_TRACING_ENDPOINT=https://otlp.arize.com/v1/traces

# --- Second real AWS account (just aws-mantle ...): only the monthly cost budget above ---
# AWS CLI profile and 12-digit account ID of the account where you call Bedrock Mantle by hand.
# RAG_MANTLE_AWS_PROFILE=rag-mantle
# RAG_MANTLE_AWS_ACCOUNT_ID=
